# Copy to .env and fill in. Never commit .env.

# From @BotFather in Telegram (/newbot).
TELEGRAM_BOT_TOKEN=
# Who may use the bot: comma-separated Telegram user IDs. Send /start to the bot to see yours.
ALLOWED_USER_IDS=

# The LLM: an OpenAI-compatible endpoint, e.g. a recipe in Local LLM Manager on port 8101.
# From the bot container, this machine is host.docker.internal; with DGXM_PUBLISH_IP=tailscale use the
# machine's Tailscale IP instead (e.g. http://100.77.48.80:8101/v1/chat/completions).
LLM_URL=http://host.docker.internal:8101/v1/chat/completions
# Leave empty to use whatever model the server runs (so "Switch to" needs no change here).
LLM_MODEL=
# Only if the model server was started with --api-key.
LLM_API_KEY=
SYSTEM_PROMPT=You are a helpful assistant. Answer briefly and in the user's language.
# Remembered question/answer pairs per chat (/reset clears them).
HISTORY_TURNS=10

# Speech-to-text.
STT_MODEL=openai/whisper-large-v3-turbo
# Empty = detect the language per message; set e.g. de / uk / en to force one.
STT_LANGUAGE=
# Share of GPU memory vLLM reserves for Whisper (0.08 of 128 GB ~ 10 GB), so your LLM still fits.
WHISPER_GPU_SHARE=0.08

# Only for gated Hugging Face models (Whisper does not need it).
HF_TOKEN=

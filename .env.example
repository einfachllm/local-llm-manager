# Copy to .env in this folder and edit (the installers do this for you). Used by install.sh, install-macos.sh,
# run.sh and docker compose.
DGXM_PORT=8090
DGXM_USER=admin
# Set a password (at least 12 characters)! The manager can start arbitrary docker containers.
# The installers replace change-me with a random password; the manager refuses to start with change-me.
DGXM_PASSWORD=change-me
# Agent mode: run this machine without a dashboard, controlled by a hub on another machine.
# At least 32 characters, e.g.:  openssl rand -hex 32   (the installers fill one in). Enter the same token
# in the hub under Hosts.
# DGXM_MODE=agent
# DGXM_AGENT_TOKEN=

# Recommended: reachable only through Tailscale (dashboard / agent API, and the model ports).
# DGXM_HOST=tailscale
# DGXM_PUBLISH_IP=tailscale

# Passed into model containers for recipes that list a bare HF_TOKEN in their env.
HF_TOKEN=

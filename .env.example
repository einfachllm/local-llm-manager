# Copy to .env (docker compose / run.sh) or ~/.config/llm-model-manager.env (systemd) and edit.
DGXM_PORT=8090
DGXM_USER=admin
# Set a password! The manager can start arbitrary docker containers.
DGXM_PASSWORD=change-me
# Agent mode: run this machine without a dashboard, controlled by a hub on another machine.
# Generate a token with:  openssl rand -hex 32   and enter the same token in the hub under Hosts.
# DGXM_MODE=agent
# DGXM_AGENT_TOKEN=

# Passed into model containers for recipes that list a bare HF_TOKEN in their env.
HF_TOKEN=
